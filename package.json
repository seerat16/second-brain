{
  "name": "projectbrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/db-setup.ts",
    "db:fixtures": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/load-fixtures.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/seed-orbit.ts",
    "eval": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/eval.ts"
  },
  "dependencies": {
    "mongodb": "^7.6.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
